[Unit]
Description=YOLO Camera Stream Server
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=charles
WorkingDirectory=/home/charles/Internet-of-Tsiken-v2
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/bash -c 'test -d "/home/charles/Internet-of-Tsiken-v2/yolo object detection/venv"'
ExecStart=/bin/bash -c "cd '/home/charles/Internet-of-Tsiken-v2/yolo object detection' && ./start_service.sh"
Restart=always
RestartSec=30
StartLimitInterval=300
StartLimitBurst=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
