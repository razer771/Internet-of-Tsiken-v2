[Unit]
Description=YOLO Camera Stream Server
After=network.target

[Service]
Type=simple
User=charles
WorkingDirectory=/home/charles/Internet-of-Tsiken-v2
ExecStart=/bin/bash -c "cd '/home/charles/Internet-of-Tsiken-v2/yolo object detection' && ./start_service.sh"
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
