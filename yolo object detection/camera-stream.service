[Unit]
Description=YOLO Camera Stream Server
After=network.target

[Service]
Type=simple
User=g1rpi2025
WorkingDirectory=/home/g1rpi2025/Internet-of-Tsiken-v2/yolo object detection
ExecStart=/usr/bin/python3 /home/g1rpi2025/Internet-of-Tsiken-v2/yolo object detection/stream_server.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
